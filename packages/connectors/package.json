{
  "name": "@eimax/connectors",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    }
  },
  "typesVersions": {
    "*": {
      "contracts": [
        "dist/contracts.d.ts"
      ]
    }
  },
  "dependencies": {
    "zod": "3.24.2"
  }
}
