
# Desenvolvimento local apenas; substituir todas as credenciais em outros ambientes.
DATABASE_URL=postgresql://eimax:eimax_local_only@127.0.0.1:55432/eimax?schema=public
API_PORT=4000
API_ORIGIN=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
DEVELOPMENT_WORKSPACE=true
REDIS_URL=redis://127.0.0.1:6379
# Gateway Evolution: configure uma vez na instalação, nunca por usuário.
EVOLUTION_GATEWAY_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
# Exceção estrita para instalação local gerenciada em http://127.0.0.1:porta.
# npm run whatsapp:setup gera configuração privada e habilita apenas sessões/QR.
EVOLUTION_LOCAL_GATEWAY_ENABLED=false
# Para suites de contrato sem acessar o gateway instalado, definir false no processo.
WHATSAPP_LOCAL_AUTOSTART=true
# Permite apenas operações de sessão/QR. Não habilita envio de mensagens.
WHATSAPP_SESSION_ENABLED=false
WHATSAPP_EXTERNAL_ENABLED=false
# Descadastro central (SAIR) entregue ao Esfera. Mapa organizationId -> empresa do Esfera.
# O token é o token de empresa gerado pelo master no Esfera; nunca commitar valores reais.
# ESFERA_OPTOUT_LINKS_JSON={"org-local":{"baseUrl":"http://127.0.0.1:8080","companyId":1,"token":"<token>"}}
ESFERA_OPTOUT_LINKS_JSON=
# Única exceção ao bloqueio WHATSAPP_EXTERNAL_ENABLED: confirmação fixa de descadastro.
# Texto único: OPT_OUT_CONFIRMATION_TEXT em packages/connectors/src/opt-out.ts.
# Inclui exatamente uma quebra de linha após "Consumidor."; não aceita texto por ambiente ou IA.
# Somente pedidos posteriores ao marco durável da primeira inicialização do worker.
OPT_OUT_CONFIRMATION_ENABLED=true
# Vazia = todos os destinatários elegíveis; opcional: números separados por vírgula.
OPT_OUT_CONFIRMATION_ALLOWLIST=
# Testes criam dados somente neste banco, nunca no eimax (porta de API isolada: 4001).
TEST_DATABASE_URL=postgresql://eimax:eimax_local_only@127.0.0.1:55432/eimax_test?schema=public
